<policies>
    <inbound>
        <base />
        <choose>
            <when condition="@(!context.Request.Headers.ContainsKey(&quot;Authorization&quot;) &amp;&amp; context.Request.Headers.ContainsKey(&quot;x-api-key&quot;))">
                <set-header name="Authorization" exists-action="override">
                    <value>@("Bearer " + context.Request.Headers.GetValueOrDefault("x-api-key", ""))</value>
                </set-header>
            </when>
        </choose>
        <set-variable name="candidateAudience" value="@{
            var raw = context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;);
            var jwt = raw.StartsWith(&quot;Bearer &quot;, StringComparison.OrdinalIgnoreCase)
                ? raw.Substring(7).AsJwt() : null;
            return jwt == null ? &quot;&quot; : jwt.Audiences.FirstOrDefault() ?? &quot;&quot;;
        }" />
        <!-- The untrusted audience selects a validator; it grants no access. -->
        <choose>
            <when condition="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;candidateAudience&quot;, &quot;&quot;) == &quot;api://__REQUIRED_GATEWAY_CLIENT_ID__&quot;)">
                <validate-jwt header-name="Authorization" require-scheme="Bearer"
                    failed-validation-httpcode="401" failed-validation-error-message="Unauthorized"
                    output-token-variable-name="validatedJwt">
                    <openid-config url="https://login.microsoftonline.com/__REQUIRED_TENANT_ID__/.well-known/openid-configuration" />
                    <audiences><audience>api://__REQUIRED_GATEWAY_CLIENT_ID__</audience></audiences>
                    <issuers><issuer>https://sts.windows.net/__REQUIRED_TENANT_ID__/</issuer></issuers>
                    <required-claims>
                        <claim name="tid"><value>__REQUIRED_TENANT_ID__</value></claim>
                        <claim name="roles" match="any"><value>Gateway.Invoke</value></claim>
                    </required-claims>
                </validate-jwt>
            </when>
            <when condition="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;candidateAudience&quot;, &quot;&quot;) == &quot;__REQUIRED_DESKTOP_CLIENT_ID__&quot;)">
                <validate-jwt header-name="Authorization" require-scheme="Bearer"
                    failed-validation-httpcode="401" failed-validation-error-message="Unauthorized"
                    output-token-variable-name="validatedJwt">
                    <openid-config url="https://login.microsoftonline.com/__REQUIRED_TENANT_ID__/v2.0/.well-known/openid-configuration" />
                    <audiences><audience>__REQUIRED_DESKTOP_CLIENT_ID__</audience></audiences>
                    <issuers><issuer>https://login.microsoftonline.com/__REQUIRED_TENANT_ID__/v2.0</issuer></issuers>
                    <required-claims>
                        <claim name="tid"><value>__REQUIRED_TENANT_ID__</value></claim>
                        <claim name="roles" match="any"><value>Gateway.Invoke</value></claim>
                    </required-claims>
                </validate-jwt>
            </when>
            <otherwise>
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                </return-response>
            </otherwise>
        </choose>
        <set-variable name="callerUpn" value="@(((Jwt)context.Variables[&quot;validatedJwt&quot;]).Claims.GetValueOrDefault(&quot;upn&quot;, &quot;&quot;).Trim().ToLowerInvariant())" />
        <set-variable name="requestedModel" value="@{
            try {
                var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
                var model = body == null ? null : body[&quot;model&quot;];
                return model != null &amp;&amp; model.Type == Newtonsoft.Json.Linq.JTokenType.String
                    ? ((string)model).Trim().ToLowerInvariant() : &quot;&quot;;
            } catch (Exception) {
                return &quot;&quot;;
            }
        }" />
        <choose>
            <when condition="@(string.IsNullOrEmpty(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;requestedModel&quot;, &quot;&quot;)))">
                <return-response>
                    <set-status code="400" reason="Invalid model field" />
                    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
                    <set-body>{"error":{"type":"invalid_request_error","message":"A JSON body with a string model field is required."}}</set-body>
                </return-response>
            </when>
        </choose>
        <include-fragment fragment-id="claude-foundry-budgets" />
        <set-variable name="monthlyModelTokenQuota" value="@{
            var defaults = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables[&quot;defaultModelTokenQuotasJson&quot;]);
            var overrides = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables[&quot;userModelTokenQuotasJson&quot;]);
            var user = (string)context.Variables[&quot;callerUpn&quot;];
            var model = (string)context.Variables[&quot;requestedModel&quot;];
            var perUser = overrides[user] as Newtonsoft.Json.Linq.JObject;
            var quota = perUser == null ? null : perUser[model];
            return (int)(quota ?? defaults[model] ?? new Newtonsoft.Json.Linq.JValue(0));
        }" />
        <choose>
            <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;callerUpn&quot;]) || (int)context.Variables[&quot;monthlyModelTokenQuota&quot;] &lt;= 0)">
                <return-response>
                    <set-status code="403" reason="Model budget not assigned" />
                    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
                    <set-body>{"error":{"type":"permission_error","message":"This identity has no positive budget for the requested model."}}</set-body>
                </return-response>
            </when>
        </choose>
        <trace source="claude-ai-gateway" severity="information">
            <message>Authenticated inference request</message>
            <metadata name="callerUpn" value="@((string)context.Variables[&quot;callerUpn&quot;])" />
            <metadata name="tenantId" value="@(((Jwt)context.Variables[&quot;validatedJwt&quot;]).Claims.GetValueOrDefault(&quot;tid&quot;, &quot;&quot;))" />
            <metadata name="objectId" value="@(((Jwt)context.Variables[&quot;validatedJwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;&quot;))" />
            <metadata name="requestId" value="@(context.RequestId.ToString())" />
            <metadata name="requestedModel" value="@((string)context.Variables[&quot;requestedModel&quot;])" />
        </trace>
        <choose>
            <when condition="@(context.Request.Url.Path.EndsWith(&quot;/v1/messages&quot;))">
                <llm-token-limit
                    counter-key="@(&quot;claude-monthly:&quot; + (string)context.Variables[&quot;callerUpn&quot;] + &quot;:&quot; + (string)context.Variables[&quot;requestedModel&quot;])"
                    token-quota="@((long)(int)context.Variables[&quot;monthlyModelTokenQuota&quot;])"
                    token-quota-period="Monthly" estimate-prompt-tokens="true"
                    remaining-quota-tokens-header-name="x-monthly-tokens-remaining"
                    tokens-consumed-header-name="x-tokens-consumed" />
                <llm-emit-token-metric namespace="ClaudeGateway">
                    <dimension name="Caller" value="@((string)context.Variables[&quot;callerUpn&quot;])" />
                    <dimension name="Model" value="@((string)context.Variables[&quot;requestedModel&quot;])" />
                </llm-emit-token-metric>
            </when>
        </choose>
        <set-header name="x-api-key" exists-action="delete" />
        <set-header name="api-key" exists-action="delete" />
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <set-query-parameter name="subscription-key" exists-action="delete" />
        <set-backend-service backend-id="claude-foundry-backend" />
        <authentication-managed-identity resource="https://ai.azure.com" />
    </inbound>
    <backend>
        <forward-request timeout="120" buffer-response="false" />
    </backend>
    <outbound><base /></outbound>
    <on-error><base /></on-error>
</policies>
