{
  "schemaVersion": 1,
  "inbound": {
    "issuer": "https://login.microsoftonline.com/__REQUIRED_TENANT_ID__/v2.0",
    "audience": "__REQUIRED_MIDDLE_TIER_AUDIENCE__",
    "requiredClaims": [
      "iss",
      "aud",
      "exp",
      "iat",
      "nbf",
      "oid",
      "tid",
      "azp",
      "scp"
    ],
    "requiredScope": "access_as_user",
    "allowedClientIds": [
      "__REQUIRED_CLIENT_APPLICATION_ID__"
    ],
    "rejectApplicationOnlyTokens": true
  },
  "downstream": {
    "audience": "__REQUIRED_DOWNSTREAM_AUDIENCE__",
    "requestedScope": "__REQUIRED_DOWNSTREAM_SCOPE__",
    "requiredDelegatedScope": "Policy.Read",
    "preservedUserClaim": "oid"
  },
  "logging": {
    "allowed": [
      "correlationId",
      "operation",
      "statusCode",
      "authorizationDecision",
      "errorCode",
      "duration"
    ],
    "prohibited": [
      "authorizationHeader",
      "userAssertion",
      "accessToken",
      "requestBody",
      "responseBody"
    ]
  }
}
