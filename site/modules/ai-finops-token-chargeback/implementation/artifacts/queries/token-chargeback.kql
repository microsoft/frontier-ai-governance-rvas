// Source: https://learn.microsoft.com/en-us/azure/architecture/ai-ml/guide/azure-openai-gateway-monitoring
// Source: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/apimanagementgatewayllmlog
// Source: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/apimanagementgatewaylogs
// Attribute gateway token use by cost center, consumer, product, API, and model.
// Keep prompt and response content out of this query output.
let Lookback = 30d;
let TokenRates = datatable(ModelAlias:string, PromptPer1K:string, CompletionPer1K:string, Currency:string)
[
  "__REQUIRED_MODEL_ALIAS__", "__REQUIRED_INPUT_TOKEN_RATE__", "__REQUIRED_OUTPUT_TOKEN_RATE__", "__REQUIRED_BILLING_CURRENCY__"
];
let ProductCostCenters = datatable(ProductId:string, CostCenter:string)
[
  "__REQUIRED_APIM_PRODUCT_ID__", "__REQUIRED_COST_CENTER__"
];
let GatewayAttribution =
ApiManagementGatewayLogs
| where TimeGenerated >= ago(Lookback)
| summarize arg_max(TimeGenerated, ProductId, ApimSubscriptionId, ApiId, OperationId) by CorrelationId;
let TokenUsage =
ApiManagementGatewayLlmLog
| where TimeGenerated >= ago(Lookback)
| summarize
    PromptTokensRaw = max(PromptTokens),
    CompletionTokensRaw = max(CompletionTokens),
    TotalTokensRaw = max(TotalTokens),
    ModelName = take_any(ModelName),
    DeploymentName = take_any(DeploymentName),
    TokenLogRows = count()
  by CorrelationId;
TokenUsage
| join kind=leftouter GatewayAttribution on CorrelationId
| extend ProductId = iif(isempty(ProductId), "unattributed-product", ProductId)
| extend Consumer = iif(isempty(ApimSubscriptionId), "unattributed-subscription", ApimSubscriptionId)
| join kind=leftouter ProductCostCenters on ProductId
| extend CostCenter = coalesce(CostCenter, "__REQUIRED_COST_CENTER_FALLBACK__")
| extend HasTokenCounts = isnotnull(PromptTokensRaw) and isnotnull(CompletionTokensRaw) and isnotnull(TotalTokensRaw)
| join kind=leftouter TokenRates on $left.ModelName == $right.ModelAlias
| extend PromptCost = todouble(PromptTokensRaw) / 1000.0 * todouble(PromptPer1K)
| extend CompletionCost = todouble(CompletionTokensRaw) / 1000.0 * todouble(CompletionPer1K)
| summarize
    PromptTokens = sumif(PromptTokensRaw, HasTokenCounts),
    CompletionTokens = sumif(CompletionTokensRaw, HasTokenCounts),
    TotalTokens = sumif(TotalTokensRaw, HasTokenCounts),
    EstimatedCost = sumif(PromptCost + CompletionCost, HasTokenCounts),
    CompleteTokenRows = countif(HasTokenCounts),
    MissingTokenRows = countif(not(HasTokenCounts)),
    TokenLogRows = sum(TokenLogRows)
  by CostCenter, Consumer, ProductId, ApiId, OperationId, ModelName, DeploymentName, Currency
| extend AttributionStatus = iif(MissingTokenRows > 0, "token-count-missing-review-required", "token-count-complete")
| order by TotalTokens desc
