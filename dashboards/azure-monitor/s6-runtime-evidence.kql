// S6 runtime evidence query pack
//
// Replace placeholders before use:
// - <correlation-id-placeholder>
// - <lookback-timespan>
// - customer table and customDimensions field names
//
// Do not export raw prompts, outputs, endpoints, tenant identifiers, or
// customer telemetry rows into this repository.

// 1. Runtime path trace by correlation ID.
let correlationId = "<correlation-id-placeholder>";
let lookback = 2h;
union isfuzzy=true requests, traces, dependencies, customEvents
| where timestamp > ago(lookback)
| where tostring(operation_Id) == correlationId
    or tostring(customDimensions["correlation_id"]) == correlationId
    or tostring(customDimensions["request_id"]) == correlationId
    or tostring(customDimensions["x-correlation-id"]) == correlationId
| extend s6Decision = tostring(customDimensions["x-s6-prompt-firewall-decision"])
| project timestamp, itemType, name, resultCode, success, operation_Id,
          cloud_RoleName, target, s6Decision, customDimensions
| order by timestamp asc

// 2. APIM / gateway policy signal.
let correlationId = "<correlation-id-placeholder>";
AzureDiagnostics
| where TimeGenerated > ago(2h)
| where CorrelationId == correlationId
    or requestId_s == correlationId
    or tostring(properties_s) has correlationId
| extend s6Decision = coalesce(
    tostring(parse_json(properties_s)["x-s6-prompt-firewall-decision"]),
    tostring(parse_json(properties_s)["promptFirewallDecision"]),
    tostring(parse_json(properties_s)["decision"])
)
| project TimeGenerated, Resource, OperationName, responseCode_d,
          backendUrl_s, policyName_s, s6Decision, properties_s
| order by TimeGenerated asc

// 3. Prompt-firewall decision summary.
let correlationId = "<correlation-id-placeholder>";
union isfuzzy=true traces, customEvents, AzureDiagnostics
| where timestamp > ago(2h) or TimeGenerated > ago(2h)
| extend eventTime = coalesce(timestamp, TimeGenerated)
| extend raw = strcat(tostring(customDimensions), " ", tostring(properties_s), " ", tostring(message))
| where raw has correlationId
| extend decision = case(
    raw has "x-s6-prompt-firewall-decision=block" or raw has "\"decision\":\"block\"", "block",
    raw has "x-s6-prompt-firewall-decision=allow" or raw has "\"decision\":\"allow\"", "allow",
    raw has "diagnostic-only", "diagnostic-only",
    "unknown"
)
| summarize events=count(), firstSeen=min(eventTime), lastSeen=max(eventTime) by decision
| order by firstSeen asc

// 4. SOC or security route signal.
let correlationId = "<correlation-id-placeholder>";
SecurityAlert
| where TimeGenerated > ago(24h)
| where tostring(ExtendedProperties) has correlationId
    or tostring(Entities) has correlationId
| project TimeGenerated, AlertName, Severity, ProviderName, SystemAlertId,
          ExtendedProperties, Entities
| order by TimeGenerated asc

// 5. Signal-state helper.
// Interpret results using the S6 signal states:
// - signal present: route and policy decision appear in the scoped time window;
// - no signal: query ran, but expected events are absent;
// - partial signal: route exists, but policy/backend/SOC signal is missing;
// - diagnostic-only: component test or inspection outage, not path proof;
// - alert routed: actionable signal reached queue, incident, alert, or manual owner;
// - unsupported route: selected control does not cover the route;
// - blocked evidence handling: records, retention, or reviewer path is missing.
