// Every Azure AI account visible to the caller in the queried scope.
// Resource Graph exposes the account, not its projects or model deployments.
// The report adds the model deployment layer per account.
Resources
| where type =~ 'microsoft.cognitiveservices/accounts'
| extend accountKind = tostring(kind)
| extend skuName = tostring(sku.name)
| extend publicNetworkAccess = tostring(properties.publicNetworkAccess)
| extend disableLocalAuth = tostring(properties.disableLocalAuth)
| extend customSubDomainName = tostring(properties.customSubDomainName)
| project
    id,
    name,
    accountKind,
    skuName,
    location,
    resourceGroup,
    subscriptionId,
    publicNetworkAccess,
    disableLocalAuth,
    customSubDomainName,
    tags
| join kind=leftouter (
    ResourceContainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionId, subscriptionName = name
  ) on subscriptionId
| project-away subscriptionId1
| order by subscriptionName asc, name asc
