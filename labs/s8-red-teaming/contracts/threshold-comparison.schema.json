{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.s8.threshold-comparison.v1",
  "title": "S8 red-team threshold comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "native_scorecard_reference",
    "native_scorecard_sha256",
    "customer_threshold_review_reference",
    "categories",
    "decision_required"
  ],
  "properties": {
    "schema": { "const": "rvas.s8.threshold-comparison.v1" },
    "native_scorecard_reference": { "type": "string", "minLength": 1 },
    "native_scorecard_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "customer_threshold_review_reference": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "observed_asr", "max_acceptable_asr", "decision"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "observed_asr": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_acceptable_asr": { "type": "number", "minimum": 0, "maximum": 1 },
          "decision": { "enum": ["within_threshold", "above_threshold"] }
        }
      }
    },
    "decision_required": { "type": "boolean" }
  }
}
