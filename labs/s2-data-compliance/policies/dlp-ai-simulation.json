  "mode": "TestWithoutNotifications",
  "state": "Enabled",
  "workload": "AI",
  "locations": {
    "includeAIApps": [
      "Microsoft365Copilot",
      "MicrosoftFoundry",
      "CopilotStudio",
      "REPLACE-WITH-APP-OR-CONNECTOR-ID"
    ],
    "excludeAIApps": []
  },
  "reviewerGroupId": "REPLACE-WITH-COMPLIANCE-REVIEWER-GROUP-ID",
  "rules": [
    {
      "name": "Detect sensitive data in AI prompts and responses",
      "priority": 0,
      "enabled": true,
      "conditions": {
        "contentContainsSensitiveInformation": [
          {
            "sensitiveInformationTypeId": "REPLACE-WITH-SIT-ID",
            "name": "Customer Confidential or Regulated Data",
