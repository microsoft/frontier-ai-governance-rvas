{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.delivery.assurance-handoff.v1",
  "title": "AI Governance Platform assurance handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gateway_proof_reference",
    "gateway_proof_decision",
    "evaluation_plan_reference",
    "assurance_owner_reference",
    "bounded_scope",
    "outcome",
    "evidence_limit",
    "decision_reference",
    "review_date",
    "next_review_date"
  ],
  "properties": {
    "schema": {
      "const": "rvas.delivery.assurance-handoff.v1"
    },
    "gateway_proof_reference": {
      "type": "string",
      "minLength": 1
    },
    "gateway_proof_decision": {
      "const": "accepted"
    },
    "evaluation_plan_reference": {
      "type": "string",
      "minLength": 1
    },
    "assurance_owner_reference": {
      "type": "string",
      "minLength": 1
    },
    "bounded_scope": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "continue",
        "hold"
      ]
    },
    "decision_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_limit": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    }
  }
}
