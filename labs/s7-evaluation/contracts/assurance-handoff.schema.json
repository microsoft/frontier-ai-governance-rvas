{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.delivery.assurance-handoff.v1",
  "title": "AI Governance Platform assurance handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "s3_gateway_proof_reference",
    "s3_gateway_proof_decision",
    "evaluation_plan_reference",
    "assurance_owner_reference",
    "outcome",
    "decision_reference"
  ],
  "properties": {
    "schema": {
      "const": "rvas.delivery.assurance-handoff.v1"
    },
    "s3_gateway_proof_reference": {
      "type": "string"
    },
    "s3_gateway_proof_decision": {
      "const": "accepted"
    },
    "evaluation_plan_reference": {
      "type": "string"
    },
    "assurance_owner_reference": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "continue",
        "hold"
      ]
    },
    "decision_reference": {
      "type": "string"
    }
  }
}
