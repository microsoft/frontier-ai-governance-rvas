{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.delivery.quality-threshold-decision.v1",
  "title": "AI Governance Platform quality threshold decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_plan_reference",
    "bounded_workload",
    "assurance_owner_reference",
    "dimensions",
    "threshold_decision",
    "decision_reference",
    "review_date"
  ],
  "properties": {
    "schema": { "const": "rvas.delivery.quality-threshold-decision.v1" },
    "evaluation_plan_reference": { "type": "string", "minLength": 1 },
    "bounded_workload": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "threshold_reference", "threshold_owner", "evaluator_reference", "coverage_limit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "threshold_reference": { "type": "string", "minLength": 1 },
          "threshold_owner": { "type": "string", "minLength": 1 },
          "evaluator_reference": { "type": "string", "minLength": 1 },
          "coverage_limit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assurance_owner_reference": { "type": "string", "minLength": 1 },
    "threshold_decision": { "enum": ["approved", "provisional", "blocked"] },
    "decision_reference": { "type": "string", "minLength": 1 },
    "review_date": { "type": "string", "format": "date" }
  }
}
