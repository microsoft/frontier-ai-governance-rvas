// Microsoft Defender XDR Security for AI hunting templates.
// Replace the placeholder aliases before use. Do not paste prompt text or response text into
// comments, query names, or exported results.

let AgentAlias = "__REQUIRED_AGENT_ALIAS__";
let Lookback = 24h;

// Agent-related alerts by title and evidence.
AlertInfo
| where Timestamp > ago(Lookback)
| where Title has_any ("agent", "prompt injection", "tool misuse", "jailbreak")
| project Timestamp, AlertId, Title, Severity, ServiceSource, DetectionSource
| order by Timestamp desc

// Agent cloud activity with payload-free fields.
CloudAppEvents
| where Timestamp > ago(Lookback)
| where Application has_any ("Microsoft 365 Copilot", "Copilot Studio", "Agent 365")
| project Timestamp, Application, ActionType, AccountObjectId, ObjectName, ResultStatus
| order by Timestamp desc

// Agent inventory surface, when available in the tenant.
AgentsInfo
| where Timestamp > ago(Lookback)
| project Timestamp, AgentId, AgentName, Platform, Owner, RiskLevel, ProtectionStatus
| order by Timestamp desc
