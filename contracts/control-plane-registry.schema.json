{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.s9.control-plane-registry.v1",
  "title": "S9 control-plane registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agents", "tools"],
  "properties": {
    "schema": { "const": "rvas.s9.control-plane-registry.v1" },
    "capturedUtc": { "type": "string", "format": "date-time" },
    "sourcesOfRecord": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceOfRecord" }
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/identity" }
    },
    "dataSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataSource" }
    },
    "reconciliationFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/reconciliationFinding" }
    }
  },
  "$defs": {
    "lifecycleState": {
      "enum": ["proposed", "active_review", "publish_ready", "published", "hold", "suspended", "deprecated", "retired", "withdrawn", null]
    },
    "sourceOfRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldFamily", "system", "owner"],
      "properties": {
        "fieldFamily": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "joinKey": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "conflictRule": { "type": ["string", "null"] },
        "coverageLimit": { "type": ["string", "null"] }
      }
    },
    "reviewFields": {
      "type": "object",
      "properties": {
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
        "lifecycleReviewRef": { "type": ["string", "null"] },
        "materialChangeReviewStatus": {
          "enum": ["not_applicable", "reviewed", "pending_review", "not_reviewed"]
        },
        "materialChangeReviewRef": { "type": ["string", "null"] },
        "lifecycleTransition": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["fromState", "toState", "decisionOwner", "reviewRef"],
          "properties": {
            "fromState": { "type": "string", "minLength": 1 },
            "toState": { "type": "string", "minLength": 1 },
            "decisionOwner": { "type": "string", "minLength": 1 },
            "reviewRef": { "type": "string", "minLength": 1 }
          }
        },
        "closureOwner": { "type": ["string", "null"] },
        "closureReviewRef": { "type": ["string", "null"] }
      },
      "required": ["materialChangeReviewStatus"]
    },
    "agent": {
      "allOf": [
        { "$ref": "#/$defs/reviewFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registryId", "displayName", "executionMode", "managed"],
          "properties": {
            "registryId": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "identityObjectId": { "type": ["string", "null"] },
            "implementationPath": { "type": ["string", "null"] },
            "executionMode": { "type": "string", "minLength": 1 },
            "managed": { "type": "boolean" },
            "riskTier": { "type": ["string", "null"] },
            "exceptionStatus": { "type": ["string", "null"] },
            "accountableOwner": { "type": ["string", "null"] },
            "technicalOwner": { "type": ["string", "null"] },
            "supportOwner": { "type": ["string", "null"] },
            "modelRefs": { "type": "array", "items": { "type": "string" } },
            "dataSourceRefs": { "type": "array", "items": { "type": "string" } },
            "telemetryRef": { "type": ["string", "null"] },
            "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
            "lifecycleReviewRef": { "type": ["string", "null"] },
            "materialChangeReviewStatus": {
              "enum": ["not_applicable", "reviewed", "pending_review", "not_reviewed"]
            },
            "materialChangeReviewRef": { "type": ["string", "null"] },
            "lifecycleTransition": { "$ref": "#/$defs/reviewFields/properties/lifecycleTransition" },
            "closureOwner": { "type": ["string", "null"] },
            "closureReviewRef": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "tool": {
      "allOf": [
        { "$ref": "#/$defs/reviewFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolId", "displayName"],
          "properties": {
            "toolId": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "parentRegistryId": { "type": ["string", "null"] },
            "apiCenterRef": { "type": ["string", "null"] },
            "gatewayRouteRef": { "type": ["string", "null"] },
            "schemaVersion": { "type": ["string", "null"] },
            "owner": { "type": ["string", "null"] },
            "consumerRegistryIds": { "type": "array", "items": { "type": "string" } },
            "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
            "lifecycleReviewRef": { "type": ["string", "null"] },
            "materialChangeReviewStatus": {
              "enum": ["not_applicable", "reviewed", "pending_review", "not_reviewed"]
            },
            "materialChangeReviewRef": { "type": ["string", "null"] },
            "lifecycleTransition": { "$ref": "#/$defs/reviewFields/properties/lifecycleTransition" },
            "closureOwner": { "type": ["string", "null"] },
            "closureReviewRef": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelRef"],
      "properties": {
        "modelRef": { "type": "string", "minLength": 1 },
        "deploymentAlias": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "quotaOwner": { "type": ["string", "null"] },
        "evaluationRef": { "type": ["string", "null"] },
        "fallbackRef": { "type": ["string", "null"] },
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityRef"],
      "properties": {
        "identityRef": { "type": "string", "minLength": 1 },
        "identityType": { "type": ["string", "null"] },
        "sponsor": { "type": ["string", "null"] },
        "authorityMode": { "type": ["string", "null"] },
        "resourceAuthorizationOwner": { "type": ["string", "null"] },
        "reviewRef": { "type": ["string", "null"] },
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataSourceRef"],
      "properties": {
        "dataSourceRef": { "type": "string", "minLength": 1 },
        "classification": { "type": ["string", "null"] },
        "permissionBoundary": { "type": ["string", "null"] },
        "minimizationPoint": { "type": ["string", "null"] },
        "dataOwner": { "type": ["string", "null"] },
        "reviewRef": { "type": ["string", "null"] }
      }
    },
    "reconciliationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingType", "status", "owner"],
      "properties": {
        "findingType": {
          "enum": ["missing_owner", "stale_version", "orphan_identity", "uncataloged_tool", "route_mismatch", "telemetry_gap", "lifecycle_conflict", "exception_aging", "other"]
        },
        "affectedRef": { "type": ["string", "null"] },
        "status": { "enum": ["open", "accepted", "deferred", "closed"] },
        "owner": { "type": "string", "minLength": 1 },
        "targetDate": { "type": ["string", "null"] },
        "evidenceRef": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] }
      }
    }
  }
}
