{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.delivery.intake.v1",
  "title": "AI Governance Platform delivery workspace intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_slug",
    "engagement_id",
    "pilot_agent_slug",
    "governance_lead",
    "platform_lead",
    "target_environment_label"
  ],
  "properties": {
    "customer_slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "engagement_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "pilot_agent_slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "governance_lead": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,78}[A-Za-z0-9]$" },
    "platform_lead": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,78}[A-Za-z0-9]$" },
    "target_environment_label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
