{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rvas.delivery.rollout-decision.v1",
  "title": "RVAS rollout decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pilot_agent_slug",
    "admission_record_reference",
    "overall_decision",
    "decision_owner_reference",
    "review_date"
  ],
  "properties": {
    "schema": { "const": "rvas.delivery.rollout-decision.v1" },
    "pilot_agent_slug": { "type": "string" },
    "admission_record_reference": { "type": "string" },
    "gateway_proof_reference": { "type": "string" },
    "assurance_handoff_reference": { "type": "string" },
    "red_team_finding_disposition_reference": { "type": ["string", "null"] },
    "catalog_registration_reference": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_name", "entry_condition_references", "rollback_reference", "change_authority", "status"],
        "properties": {
          "stage_name": { "enum": ["nonproduction", "limited_preview", "expanded_preview", "production"] },
          "entry_condition_references": { "type": "array", "items": { "type": "string" } },
          "rollback_reference": { "type": "string" },
          "change_authority": { "type": "string" },
          "status": { "enum": ["pending", "active", "completed", "deferred", "blocked"] }
        }
      }
    },
    "overall_decision": { "enum": ["proceed_to_next_stage", "hold", "defer", "rejected"] },
    "decision_owner_reference": { "type": "string" },
    "review_date": { "type": "string", "format": "date" }
  }
}
