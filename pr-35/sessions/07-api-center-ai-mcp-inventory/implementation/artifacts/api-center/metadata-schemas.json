[
  {
    "name": "businessOwner",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Business owner\",\"description\":\"Accountable business role or group.\"}"
  },
  {
    "name": "technicalOwner",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Technical owner\",\"description\":\"Operating engineering role or group.\"}"
  },
  {
    "name": "assetKind",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"AI asset kind\",\"enum\":[\"ai-api\",\"agent-api\",\"mcp-server\"]}"
  },
  {
    "name": "dataClassification",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Data classification\",\"enum\":[\"public\",\"internal\",\"confidential\",\"restricted\"]}"
  },
  {
    "name": "permittedConsumers",
    "required": true,
    "schema": "{\"type\":\"array\",\"title\":\"Permitted consumers\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"uniqueItems\":true}"
  },
  {
    "name": "modelProvider",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Model or provider\",\"description\":\"Model provider or not-applicable for a non-model MCP server.\"}"
  },
  {
    "name": "residencyProfile",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Residency profile\",\"description\":\"Approved processing and storage residency decision.\"}"
  },
  {
    "name": "riskTier",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Risk tier\",\"enum\":[\"low\",\"moderate\",\"high\",\"critical\"]}"
  },
  {
    "name": "evaluationResultsUrl",
    "required": true,
    "schema": "{\"type\":\"string\",\"format\":\"uri\",\"title\":\"Evaluation results URL\",\"description\":\"Owned evaluation record or evaluation backlog URL.\"}"
  },
  {
    "name": "lastReviewDate",
    "required": true,
    "schema": "{\"type\":\"string\",\"format\":\"date\",\"title\":\"Last review date\"}"
  },
  {
    "name": "expiryDate",
    "required": true,
    "schema": "{\"type\":\"string\",\"format\":\"date\",\"title\":\"Expiry date\"}"
  },
  {
    "name": "implementationSession",
    "required": true,
    "schema": "{\"type\":\"string\",\"title\":\"Implementation session\",\"description\":\"Marker for the operational implementation scope.\"}"
  }
]
