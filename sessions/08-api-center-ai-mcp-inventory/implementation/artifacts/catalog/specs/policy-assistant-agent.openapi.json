{
  "openapi": "3.0.3",
  "info": {
    "title": "Policy assistant agent API",
    "version": "1.0.0",
    "description": "Design-time contract for the Session 06 policy-assistant Responses endpoint."
  },
  "paths": {
    "/responses": {
      "post": {
        "operationId": "invokePolicyAssistant",
        "summary": "Invoke the governed policy assistant",
        "description": "Submits a request to the pinned Session 06 policy assistant.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent response."
          },
          "401": {
            "description": "Missing or invalid Microsoft Entra identity."
          },
          "403": {
            "description": "Caller lacks the required agent permission."
          }
        },
        "security": [
          {
            "entraBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseRequest": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "stream": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "entraBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
