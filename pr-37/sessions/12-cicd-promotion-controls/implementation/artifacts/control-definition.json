{
  "schemaVersion": 1,
  "implementationSession": "12-cicd-promotion-controls",
  "controlObjective": "One GitHub Actions workflow validates an exact release, deploys it to nonproduction, runs the required checks, waits for production approval, deploys the same release to production, verifies routing, and records the approved manifest.",
  "repository": {
    "host": "github.com",
    "owner": "__REQUIRED_GITHUB_OWNER__",
    "name": "__REQUIRED_GITHUB_REPOSITORY__",
    "defaultBranch": "__REQUIRED_PROTECTED_DEFAULT_BRANCH__",
    "workflowPath": ".github/workflows/controlled-promotion.yml",
    "restoreWorkflowPath": ".github/workflows/restore-previous-release.yml"
  },
  "githubEnvironments": {
    "nonproductionPreview": {
      "name": "nonproduction-preview",
      "oidcSubject": "__REQUIRED_NONPRODUCTION_PREVIEW_EXACT_OIDC_SUBJECT__"
    },
    "nonproduction": {
      "name": "nonproduction",
      "oidcSubject": "__REQUIRED_NONPRODUCTION_EXACT_OIDC_SUBJECT__",
      "requiredReviewerTeamSlug": "__REQUIRED_NONPRODUCTION_REVIEWER_TEAM_SLUG__",
      "preventSelfReview": "__REQUIRED_NONPRODUCTION_PREVENT_SELF_REVIEW_TRUE__"
    },
    "productionPreview": {
      "name": "production-preview",
      "oidcSubject": "__REQUIRED_PRODUCTION_PREVIEW_EXACT_OIDC_SUBJECT__"
    },
    "production": {
      "name": "production",
      "oidcSubject": "__REQUIRED_PRODUCTION_EXACT_OIDC_SUBJECT__",
      "planSupportsRequiredProtection": "__REQUIRED_PRODUCTION_ENVIRONMENT_PLAN_SUPPORT_CONFIRMED_TRUE__",
      "requiredReviewerRole": "__REQUIRED_PRODUCTION_REVIEWER_ROLE__",
      "requiredReviewerTeamSlug": "__REQUIRED_PRODUCTION_REVIEWER_TEAM_SLUG__",
      "preventSelfReview": "__REQUIRED_PREVENT_SELF_REVIEW_TRUE__",
      "branchOrTagRestriction": "__REQUIRED_PRODUCTION_BRANCH_OR_TAG_RESTRICTION__",
      "adminBypassDisabled": "__REQUIRED_ADMIN_BYPASS_DISABLED_TRUE__"
    }
  },
  "azure": {
    "authentication": "GitHub OIDC to Microsoft Entra workload identity federation",
    "clientSecretAllowed": false,
    "tenantId": "__REQUIRED_AZURE_TENANT_ID__",
    "nonproductionClientId": "__REQUIRED_NONPRODUCTION_AZURE_CLIENT_ID__",
    "productionClientId": "__REQUIRED_PRODUCTION_AZURE_CLIENT_ID__",
    "nonproductionPreviewFederatedCredentialName": "__REQUIRED_NONPRODUCTION_PREVIEW_FEDERATED_CREDENTIAL_NAME__",
    "nonproductionFederatedCredentialName": "__REQUIRED_NONPRODUCTION_FEDERATED_CREDENTIAL_NAME__",
    "productionPreviewFederatedCredentialName": "__REQUIRED_PRODUCTION_PREVIEW_FEDERATED_CREDENTIAL_NAME__",
    "productionFederatedCredentialName": "__REQUIRED_PRODUCTION_FEDERATED_CREDENTIAL_NAME__",
    "nonproductionRoleAssignment": "Contributor",
    "productionRoleAssignment": "Contributor"
  },
  "targetScopes": {
    "nonproduction": "/subscriptions/__REQUIRED_NONPRODUCTION_SUBSCRIPTION_ID__/resourceGroups/__REQUIRED_NONPRODUCTION_RESOURCE_GROUP__",
    "production": "/subscriptions/__REQUIRED_PRODUCTION_SUBSCRIPTION_ID__/resourceGroups/__REQUIRED_PRODUCTION_RESOURCE_GROUP__"
  },
  "sourcePaths": {
    "bicepEntrypoint": "__REQUIRED_BICEP_ENTRYPOINT_PATH__",
    "apimPolicy": "__REQUIRED_APIM_POLICY_PATH__",
    "unitTestScript": "__REQUIRED_UNIT_TEST_SCRIPT_PATH__",
    "session10ReleaseGate": "sessions/09-foundry-evaluations-quality-gates/implementation/scripts/release-gate.py",
    "session10ReleasePolicy": "sessions/09-foundry-evaluations-quality-gates/implementation/artifacts/release/release-policy.json",
    "session10GateSelfTest": "sessions/09-foundry-evaluations-quality-gates/implementation/scripts/test_release_gate.py",
    "session10ThresholdPolicy": "sessions/09-foundry-evaluations-quality-gates/implementation/artifacts/eval/thresholds.yaml",
    "session10EvaluationSpec": "sessions/09-foundry-evaluations-quality-gates/implementation/artifacts/eval/evaluation-spec.json",
    "session10Dataset": "sessions/09-foundry-evaluations-quality-gates/implementation/artifacts/eval/data/golden-v1.jsonl",
    "session12SmokePowerShell": "sessions/11-observability-cost-operations/implementation/scripts/smoke.ps1",
    "session12SmokeBash": "sessions/11-observability-cost-operations/implementation/scripts/smoke.sh",
    "routingControlScript": "__REQUIRED_ROUTING_CONTROL_SCRIPT_PATH__",
    "releaseStoreScript": "__REQUIRED_RELEASE_STORE_SCRIPT_PATH__"
  },
  "releaseCommit": {
    "source": "workflow_dispatch.release_sha",
    "format": "full-40-character-git-sha",
    "approvedBranchSource": "repository.defaultBranch",
    "workflowRefMustMatchApprovedBranch": true,
    "mustBeReachableFromApprovedBranch": true,
    "checkoutMustMatch": true,
    "manifestMustMatch": true
  },
  "immutableRelease": {
    "promptVersion": "__REQUIRED_PROMPT_VERSION__",
    "agentName": "__REQUIRED_AGENT_NAME_OR_ID__",
    "agentVersion": "__REQUIRED_AGENT_VERSION__",
    "modelDeploymentAlias": "__REQUIRED_MODEL_DEPLOYMENT_VERSION_ALIAS__",
    "apimPolicyVersion": "__REQUIRED_APIM_POLICY_VERSION__",
    "evaluationRunId": "__REQUIRED_EVALUATION_RUN_ID__",
    "evaluationThresholdPolicyVersion": "__REQUIRED_EVALUATION_THRESHOLD_POLICY_VERSION__",
    "evaluationThresholdPolicySha256": "__REQUIRED_EVALUATION_THRESHOLD_POLICY_SHA256__"
  },
  "agentPortfolio": {
    "frameworkPath": "__REQUIRED_APPROVED_AGENT_FRAMEWORK_PATH__",
    "frameworkExceptionApprovalReference": "N/A",
    "frameworkExceptionSupportOwnerRole": "__REQUIRED_FRAMEWORK_EXCEPTION_SUPPORT_OWNER_ROLE_OR_NA__",
    "duplicateReviewDecision": "__REQUIRED_DUPLICATE_AGENT_REVIEW_DECISION__",
    "duplicateReviewOwnerRole": "__REQUIRED_DUPLICATE_REVIEW_OWNER_ROLE__",
    "reviewedAgentInventoryReference": "__REQUIRED_REVIEWED_AGENT_INVENTORY_REFERENCE__"
  },
  "routing": {
    "strategy": "__REQUIRED_ROUTING_STRATEGY_CANARY_OR_BLUE_GREEN__",
    "existingSession05Or06SupportConfirmed": "__REQUIRED_EXISTING_ROUTING_SUPPORT_CONFIRMED_TRUE_OR_FALSE__",
    "candidateSelector": "__REQUIRED_CANDIDATE_ROUTING_SELECTOR__",
    "stableSelector": "__REQUIRED_STABLE_ROUTING_SELECTOR__",
    "unsupportedBehavior": "stop-and-retain-100-percent-on-previous-approved-release"
  },
  "records": {
    "buildAndEvaluationSystems": [
      "GitHub Actions",
      "Microsoft Foundry"
    ],
    "approvedReleaseStore": "__REQUIRED_APPROVED_RELEASE_STORE__",
    "repositoryRuntimeOutputAllowed": false,
    "externalGateArtifacts": {
      "session10EvaluationResults": {
        "interface": "releaseStoreScript",
        "retrieveMode": "RetrieveEvaluationResult",
        "temporaryArtifactOnly": true,
        "repositoryMirrorAllowed": false
      },
      "session11SecurityReleaseAttestation": {
        "schemaVersion": 1,
        "recordType": "security-release-attestation",
        "interface": "releaseStoreScript",
        "retrieveMode": "RetrieveSecurityReleaseAttestation",
        "requiredAuthorizationStatus": "authorized",
        "requiredConfirmationStatus": "confirmed",
        "temporaryArtifactOnly": true,
        "repositoryMirrorAllowed": false
      }
    },
    "manifestFinalizationFailureBehavior": "stop-and-require-manual-restore",
    "releaseRecordLifecycle": {
      "updater": "Controlled AI release promotion workflow after production deployment and routing",
      "reviewCadence": "Every successful production promotion and before manual restore",
      "consumer": "Approved release store and Restore previous AI release workflow",
      "repositoryMirrorAllowed": false
    }
  }
}
